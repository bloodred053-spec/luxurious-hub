{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "luxurious-hub",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "luxurious-hub-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "luxurious-hub-images"
    }
  ]
}
